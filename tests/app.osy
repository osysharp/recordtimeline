// The producer's test project for Osysharp.RecordTimeline — a small sales team's pipeline: opportunities, the quotes made for
// them, and what happens to each. NOT a helpdesk on purpose: the kit names no record and no event, and this app raises
// its own (`QuoteSent`, `QuoteAccepted`) about its own `Quote` rows, which roll up to their `Opportunity`.
app ActivityKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.RecordTimeline@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
}
